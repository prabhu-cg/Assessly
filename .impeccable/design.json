  "narrative": {
    "northStar": "The Working Ledger",
    "overview": "Assessly's world is warm paper and one burnt-orange voice. Pages sit on a cream ground; the things people work with are white and held by parchment hairlines. A single terracotta accent means act here or this is yours. Manrope carries every word, and tokens are shared with Doxa.",
    "keyCharacteristics": [
      "One accent, terracotta.",
      "Cream ground, white working surfaces, hairline rules.",
      "Manrope only, small fixed type scale.",
      "Shared teacher and student shell.",
      "Sign-in pairs a tinted photograph panel with the form; student sign-in stays a centred card.",
      "Dark mode is a warm brown-black ramp."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Terracotta is the only accent. It marks the primary action, the focus state and the brand mark.",
        "section": "colors"
      },
      {
        "name": "The Cream Ground Rule",
        "body": "Page grounds are surface; working surfaces are card. Never hardcode a cream hex.",
        "section": "colors"
      },
      {
        "name": "The Token Only Rule",
        "body": "No literal brand hex or bg-white in components; use tokens.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Size Rule",
        "body": "Emphasis comes from weight and ink vs ink-muted; no fluid type.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "Cards, rows, badges and inputs have no resting shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use bg-surface for page grounds and bg-card for cards, forms and popovers.",
      "Do keep terracotta to the primary action, focus, the mark and one emphasis phrase per view.",
      "Do separate surfaces with 1px hairlines and tone, and keep resting surfaces shadowless.",
      "Do open create, edit and preview flows in a right-hand drawer.",
      "Do use tabular-nums for scores, marks, counts and timers."
    ],
    "donts": [
      "Don't write a literal brand hex, bg-white, or a hardcoded cream in components.",
      "Don't put a second accent colour next to terracotta for decoration.",
      "Don't add a shadow to cards, rows, badges or inputs at rest.",
      "Don't split student sign-in into the photograph layout.",
      "Don't use neutral grey for dark mode."
    ]
  }
